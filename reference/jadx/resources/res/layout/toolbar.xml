<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/ToolbarTheme"
    android:id="@+id/toolbar"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:paddingStart="@dimen/spacing_medium_more"
    android:paddingEnd="@dimen/spacing_medium_more"
    android:transitionName="toolbar"
    android:elevation="0dp"
    app:contentInsetStartWithNavigation="@dimen/spacing_low"
    app:elevation="0dp"
    app:popupTheme="?attr/mPopupTheme"
    app:subtitleTextAppearance="@style/Toolbar.SubtitleText"
    app:titleMarginStart="@dimen/spacing_medium_more"
    app:titleTextAppearance="@style/Toolbar.TitleText"/>
