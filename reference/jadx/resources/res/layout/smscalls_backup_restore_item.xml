<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.listitem.ListItemLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.swiftapps.swiftbackup.views.SwiftListItemCardView
        android:id="@+id/item_card"
        android:duplicateParentState="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_medium_more"
        app:contentPaddingBottom="0dp"
        app:contentPaddingLeft="0dp"
        app:contentPaddingRight="0dp"
        app:contentPaddingTop="0dp"
        app:swipeEnabled="false">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_fake"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_user_default"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="@+id/image_icon"
                app:layout_constraintEnd_toEndOf="@+id/image_icon"
                app:layout_constraintStart_toStartOf="@+id/image_icon"
                app:layout_constraintTop_toTopOf="@+id/image_icon"
                app:tint="?attr/colorAccent"/>
            <ImageView
                android:id="@+id/image_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:adjustViewBounds="true"
                android:layout_marginStart="@dimen/spacing_normal_more"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <org.swiftapps.swiftbackup.views.MCheckBox
                android:id="@+id/cb"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_title"
                android:paddingTop="@dimen/spacing_medium"
                android:layout_width="wrap_content"
                android:layout_marginStart="@dimen/spacing_normal"
                app:layout_constraintStart_toEndOf="@+id/image_icon"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Title"/>
            <ImageView
                android:id="@+id/iv_call_status"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginBottom="@dimen/spacing_lowest"
                android:layout_marginStart="@dimen/spacing_low"
                app:layout_constraintBottom_toBottomOf="@+id/tv_title"
                app:layout_constraintStart_toEndOf="@+id/tv_title"/>
            <TextView
                android:id="@+id/tv_subtitle1"
                android:layout_width="0dp"
                android:maxLines="2"
                android:layout_marginEnd="@dimen/spacing_medium"
                app:layout_constraintEnd_toStartOf="@+id/cb"
                app:layout_constraintStart_toStartOf="@+id/tv_title"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"
                style="@style/Subtitle"/>
            <TextView
                android:textColor="@color/acnt"
                android:id="@+id/tv_subtitle2"
                android:paddingBottom="@dimen/spacing_medium"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/spacing_medium"
                app:layout_constraintEnd_toStartOf="@+id/cb"
                app:layout_constraintStart_toStartOf="@+id/tv_title"
                app:layout_constraintTop_toBottomOf="@+id/tv_subtitle1"
                style="@style/Subtitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </org.swiftapps.swiftbackup.views.SwiftListItemCardView>
</com.google.android.material.listitem.ListItemLayout>
