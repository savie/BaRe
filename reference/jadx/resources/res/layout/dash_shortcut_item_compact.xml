<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/subtitle_smaller"
        android:textColor="?android:attr/textColorSecondary"
        android:id="@+id/btn"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:fontFamily="@font/main_medium"
        android:paddingStart="36dp"
        android:paddingEnd="10dp"
        android:layout_marginHorizontal="@dimen/spacing_low"
        android:layout_marginVertical="0dp"
        app:backgroundTint="?attr/cardBackgroundColor"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image_icon"
        app:strokeColor="?attr/dividerColor"
        app:strokeWidth="1dp"
        style="@style/MDCButton.Outlined.Rounded.Icon"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/image_icon"
        android:background="@drawable/circle"
        android:padding="8dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</FrameLayout>
