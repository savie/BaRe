<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/bottom_dialog_drag_indicator"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_medium"/>
    <include
        android:id="@+id/toggle_keep_protected_backups"
        layout="@layout/delete_app_backups_dialog_switch_item"/>
    <include
        android:id="@+id/toggle_keep_last_backup"
        layout="@layout/delete_app_backups_dialog_switch_item"/>
    <com.google.android.material.button.MaterialButton
        android:textColor="@color/wht"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/btn_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_normal"
        android:text="@string/delete"
        app:backgroundTint="@color/red"
        app:icon="@drawable/ic_delete"
        app:iconTint="@color/wht"
        style="@style/M3ButtonFilled.Large"/>
</LinearLayout>
