<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/spacing_medium_more">
    <TextView
        android:ellipsize="none"
        android:id="@+id/tv_title"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_low_more"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/iv_section_help"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Title"/>
    <ImageView
        android:id="@+id/iv_section_help"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_help"
        android:tintMode="src_in"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toStartOf="@+id/iv_section_select_toggle"
        app:layout_constraintStart_toEndOf="@+id/tv_title"
        app:layout_constraintTop_toTopOf="@+id/tv_title"
        app:tint="?android:attr/textColorSecondary"/>
    <ImageView
        android:id="@+id/iv_section_select_toggle"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_check_circle_outline"
        android:contentDescription="@string/select_all"
        android:tintMode="src_in"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_section_help"
        app:layout_constraintTop_toTopOf="@+id/tv_title"
        app:tint="?android:attr/textColorSecondary"/>
    <org.swiftapps.swiftbackup.views.QuickRecyclerView
        android:id="@+id/rv_bre_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="com.google.android.flexbox.FlexboxLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
