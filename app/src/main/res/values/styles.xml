<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BaRe.Intro" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/bare_primary_accent</item>
        <item name="android:colorControlActivated">#FFAFB9</item>
        <item name="android:colorBackground">@color/bare_surface_container</item>
        <item name="android:windowBackground">#261B1D</item>
        <item name="android:statusBarColor">#261B1D</item>
        <item name="android:navigationBarColor">#261B1D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/bare_text_primary</item>
        <item name="android:textColorSecondary">@color/bare_text_secondary</item>
        <item name="android:colorButtonNormal">#3A2A2D</item>
    </style>
    <style name="AccountMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">68dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:drawablePadding">18dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>