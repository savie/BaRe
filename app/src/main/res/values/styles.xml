<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardStyleNormal">@style/CardStyleNormal</item>
        <item name="cardStyle">@style/CardStyleNormal</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/surface_container</item>
        <item name="android:navigationBarColor">@color/surface_container</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="CardStyleNormal" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/cardBackgroundColor</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Title">
        <item name="android:textSize">@dimen/title</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Title.Large" parent="@style/Title">
        <item name="android:textSize">@dimen/title_large</item>
    </style>
    <style name="Subtitle">
        <item name="android:textSize">@dimen/subtitle</item>
        <item name="android:textColor">?android:textColorSecondary</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Subtitle.Large" parent="@style/Subtitle">
        <item name="android:textSize">@dimen/subtitle_large</item>
    </style>
    <style name="IntroBenefitCard" parent="@style/CardStyleNormal">
        <item name="android:minHeight">124dp</item>
        <item name="cardBackgroundColor">?attr/cardBackgroundColor</item>
    </style>
    <style name="IntroBenefitIconCard" parent="@style/Widget.Material3.CardView.Filled">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="GoogleSignInButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">@dimen/subtitle_large</item>
        <item name="android:textColor">@color/google_sign_in_button_text</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/google_sign_in_button_background</item>
        <item name="fontFamily">sans-serif-bold</item>
        <item name="iconTint">@null</item>
        <item name="rippleColor">@color/google_sign_in_button_ripple</item>
        <item name="strokeColor">@color/google_sign_in_button_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="M3ButtonOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">@dimen/subtitle_large</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="backgroundTint">?attr/colorBackgroundActivated</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="rippleColor">?attr/colorBackgroundActivated</item>
        <item name="strokeColor">@color/google_sign_in_button_stroke</item>
    </style>
    <style name="Widget.Material3.Button.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">@dimen/subtitle_large</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>