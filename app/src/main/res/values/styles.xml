<resources>
    <style name="BaReTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="colorSurface">#FAFAFA</item>
    </style>
    <style name="SegmentCategoryCaption" parent="Widget.Material3.TextView">
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="CardTitle" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?attr/listPreferredItemHeightSmall</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Title" parent="">
        <item name="android:textSize">@dimen/title</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFamily">@font/main_medium</item>
    </style>
    <style name="Title.Large" parent="@style/Title">
        <item name="android:textSize">@dimen/title_large</item>
    </style>
    <style name="Subtitle" parent="">
        <item name="android:textSize">@dimen/subtitle</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Subtitle.Large" parent="@style/Subtitle">
        <item name="android:textSize">@dimen/subtitle_large</item>
    </style>
    <style name="TextCaption" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="CardStyleNormal" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:outlineSpotShadowColor">?colorSurface</item>
        <item name="cardBackgroundColor">?cardBackgroundColor</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">false</item>
    </style>
    <style name="CardStyleStroked" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
    </style>
    <style name="DetailCardButtons" parent="@style/M3ButtonFilled">
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
    </style>
    <style name="DetailMiniButton" parent="@style/M3ButtonTonal">
        <item name="android:textSize">@dimen/subtitle</item>
        <item name="android:minHeight">0dp</item>
    </style>
    <style name="DetailMiniButton.Error" parent="@style/M3ButtonTonal.Error"/>
    <style name="DividerThinNoMargins" parent="">
        <item name="android:background">?attr/dividerColor</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/divider_height</item>
    </style>
    <style name="FloatingActionButtonPrimaryStyle" parent="Widget.Material3.FloatingActionButton.Primary"/>
    <style name="ExtendedFloatingActionButtonPrimaryStyle" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary"/>
    <style name="ItemSubtitle" parent="@style/Subtitle"/>
    <style name="ItemSubtitle.Caps" parent="@style/ItemSubtitle">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="M3ButtonFilled" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:textSize">@dimen/subtitle_large</item>
        <item name="android:stateListAnimator">@animator/button_state_list_animator_m3</item>
        <item name="fontFamily">@font/main_medium</item>
        <item name="iconGravity">textStart</item>
    </style>
    <style name="M3ButtonFilled.Error" parent="@style/M3ButtonFilled">
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">?attr/colorError</item>
        <item name="iconTint">@android:color/white</item>
    </style>
    <style name="M3ButtonFilled.Large" parent="@style/M3ButtonFilled">
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="fontFamily">@font/main_medium</item>
    </style>
    <style name="M3ButtonOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">@dimen/subtitle_large</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <style name="M3ButtonTonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textSize">@dimen/subtitle_large</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="fontFamily">@font/main_medium</item>
    </style>
    <style name="M3ButtonTonal.Error" parent="@style/M3ButtonTonal">
        <item name="android:textColor">?attr/colorError</item>
        <item name="backgroundTint">?attr/colorErrorContainer</item>
    </style>
    <style name="M3DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="fontFamily">@font/main_regular</item>
    </style>
    <style name="M3DialogButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:letterSpacing">0.03</item>
        <item name="fontFamily">@font/main_medium</item>
    </style>
    <style name="M3DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text"/>
    <style name="M3DialogTitleTextAppearance" parent="TextAppearance.Material3.HeadlineSmall"/>
    <style name="M3MaterialAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog"/>
    <style name="M3CheckedTextViewStyle" parent="Widget.Material3.CheckedTextView"/>
    <style name="M3TextInputEditTextPassword">
        <item name="android:fontFamily">@font/mono_regular</item>
        <item name="fontFamily">@font/mono_regular</item>
    </style>
    <style name="M3TilFilledDense" parent="Widget.Material3.TextInputLayout.FilledBox.Dense"/>
    <style name="M3TilFilledDenseDropdown" parent="Widget.Material3.TextInputLayout.FilledBox.Dense.ExposedDropdownMenu"/>
    <style name="M3TilOutlinedDense" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense"/>
    <style name="M3TilOutlinedDenseDropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"/>
    <style name="M3TilTextAppearanceAffix" parent="TextAppearance.MaterialComponents.Subtitle1"/>
    <style name="M3TilTextAppearanceCaption" parent="TextAppearance.MaterialComponents.Caption"/>
    <style name="MCardTitle" parent="@style/Title.Large"/>
    <style name="OverflowButtonStyle" parent="Widget.AppCompat.ActionButton.Overflow"/>
    <style name="PopupMenuSubtitle" parent="@style/Subtitle"/>
    <style name="PopupMenuTitle" parent="@style/Title"/>
    <style name="SwipeActionPreviewButton" parent="Widget.Material3.Button.IconButton.Filled"/>
    <style name="TitleOnlyAlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert"/>
    <style name="Toolbar.ActionMenuText" parent="TextAppearance.AppCompat.Widget.ActionBar.Menu"/>
    <style name="Toolbar.NavigationButton" parent="Widget.AppCompat.Toolbar.Button.Navigation"/>
    <style name="Toolbar.SubtitleText" parent="TextAppearance.AppCompat.Widget.ActionBar.Subtitle"/>
    <style name="Toolbar.TitleText" parent="TextAppearance.AppCompat.Widget.ActionBar.Title"/>
    <style name="ToolbarDivider" parent="@style/DividerThinNoMargins"/>
    <style name="ToolbarTheme" parent=""/>
</resources>