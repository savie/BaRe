<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CardTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?listPreferredItemHeightSmall</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="CircularActionIcon">
        <item name="android:background">@drawable/circle_action_icon_ripple</item>
        <item name="android:padding">@dimen/spacing_low_more</item>
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>
    <style name="M3ButtonTonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textSize">@dimen/subtitle_large</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">?attr/colorBackgroundActivated</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="rippleColor">?attr/colorBackgroundActivated</item>
    </style>
    <style name="Widget.Material3.ListItemCardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/cardBackgroundColor</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="SwiftSegmentedListItemCardView" parent="@style/Widget.Material3.ListItemCardView">
        <item name="cardCornerRadius">@dimen/corner_radius_small</item>
    </style>
    <style name="SegmentedListItemCardView">
        <item name="listItemCardViewStyle">@style/SwiftSegmentedListItemCardView</item>
        <item name="segmentedListItemBottomMargin">@dimen/segmented_list_item_bottom_margin</item>
    </style>
</resources>