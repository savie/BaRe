<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/primaryNavigation"
        android:fitsSystemWindows="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:itemIconTint="@color/bottom_nav_icon_tint"
        app:itemTextAppearanceActive="@style/NavigationRailTextAppearanceActive"
        app:itemTextAppearanceInactive="@style/NavigationRailTextAppearanceInactive"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/menu_bottom_home"
        app:menuGravity="center"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/home_content_pane"
        android:fitsSystemWindows="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/home_rail_content_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/primaryNavigation"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/home_rail_content_max_width">
        <include
            android:id="@+id/home_appbar"
            layout="@layout/home_appbar"/>
        <org.swiftapps.swiftbackup.views.NoSwipeViewPager
            android:id="@+id/viewPager"
            android:paddingTop="@dimen/spacing_low"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <FrameLayout
        android:id="@+id/container_btn_new_schedule"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/home_content_pane"
        app:layout_constraintEnd_toEndOf="@+id/home_content_pane"
        app:layout_constraintStart_toStartOf="@+id/home_content_pane"
        app:layout_constraintTop_toTopOf="@+id/home_content_pane">
        <org.swiftapps.swiftbackup.home.schedule.ui.ScheduleFabMenuView
            android:id="@+id/schedule_fab_menu"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
