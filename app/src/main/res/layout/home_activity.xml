<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?android:attr/colorBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:orientation="horizontal">
        <TextView android:id="@+id/home_profile" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center"
            android:text="A" android:textSize="16sp" android:textColor="#FFFFFF" android:background="@drawable/account_avatar_background"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
            android:text="BΛR☰" android:textStyle="bold" android:textSize="17sp"/>
        <TextView android:id="@+id/home_search" android:layout_width="52dp" android:layout_height="40dp" android:gravity="center"
            android:text="⌕" android:textSize="26sp" android:background="@drawable/home_search_button_background"
            android:contentDescription="@string/home_search" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/home_content_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/home_tab_home" android:textAllCaps="true" android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" android:layout_marginBottom="16dp"/>
            <LinearLayout android:id="@+id/home_overview_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/home_storage_card" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp" android:background="@drawable/intro_card_background">
                    <TextView android:id="@+id/home_storage_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_internal_storage"
                        android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:id="@+id/home_storage_value" android:text="@string/home_storage_value" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFAFB9"/>
                    <ProgressBar android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp"
                        android:id="@+id/home_storage_progress" style="?android:attr/progressBarStyleHorizontal" android:max="100" android:progress="0"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:id="@+id/home_storage_used" android:text="@string/home_storage_used" android:textColor="?android:attr/textColorSecondary"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"
                        android:background="?android:attr/listDivider"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_root_status"
                        android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:id="@+id/home_root_status_value" android:text="@string/home_root_not_granted" android:textSize="20sp" android:textColor="#9CCC65"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/home_root_status_detail" android:text="@string/home_root_version"
                        android:textColor="?android:attr/textColorSecondary"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"
                        android:background="?android:attr/listDivider"/>
                    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/home_chip_apps" android:padding="10dp" android:clickable="true" android:focusable="true" android:text="@string/home_chip_apps"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/home_chip_messages" android:padding="10dp" android:clickable="true" android:focusable="true" android:text="@string/home_chip_messages"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/home_chip_call_logs" android:padding="10dp" android:clickable="true" android:focusable="true" android:text="@string/home_chip_call_logs"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/home_chip_folders" android:padding="10dp" android:clickable="true" android:focusable="true" android:text="@string/home_chip_folders"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/home_chip_wallpapers" android:padding="10dp" android:clickable="true" android:focusable="true" android:text="@string/home_chip_wallpapers"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/home_chip_wifi" android:padding="10dp" android:clickable="true" android:focusable="true" android:text="@string/home_chip_wifi"/>
                    </GridLayout>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp"
                    android:text="@string/home_apps_quick_actions" android:textStyle="bold" android:textSize="14sp"/>
                <LinearLayout android:id="@+id/action_backup_apps" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp" android:background="@drawable/intro_card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_backup_apps" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_backup_apps_subtitle"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/action_restore_apps" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp" android:layout_marginTop="6dp" android:background="@drawable/intro_card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_restore_apps" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_restore_apps_subtitle"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="12dp" android:background="@drawable/intro_card_background" android:id="@+id/action_restore_from_device" android:clickable="true" android:focusable="true" android:text="@string/home_from_device"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:padding="12dp" android:background="@drawable/intro_card_background" android:id="@+id/action_restore_from_cloud" android:clickable="true" android:focusable="true" android:text="@string/home_from_cloud"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/action_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp"
                    android:layout_marginTop="6dp" android:background="@drawable/intro_card_background" android:text="@string/home_more_actions" android:textStyle="bold" android:textSize="18sp"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"
                    android:text="MESSAGES QUICK ACTIONS" android:textSize="12sp" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary"/>
                <LinearLayout android:id="@+id/messages_quick_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/intro_card_background">
                    <LinearLayout android:id="@+id/action_backup_messages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Backup messages" android:textSize="16sp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Create a new backup of all messages on this device" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#332F292B"/>
                    <LinearLayout android:id="@+id/action_restore_messages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restore messages" android:textSize="16sp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Restore messages from the most recent backup" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                            <TextView android:id="@+id/action_messages_from_device" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="12dp" android:background="@drawable/intro_card_background" android:text="@string/home_from_device" android:clickable="true" android:focusable="true"/>
                            <TextView android:id="@+id/action_messages_from_cloud" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:padding="12dp" android:background="@drawable/intro_card_background" android:text="@string/home_from_cloud" android:clickable="true" android:focusable="true"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"
                    android:text="CALL LOGS QUICK ACTIONS" android:textSize="12sp" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary"/>
                <LinearLayout android:id="@+id/calls_quick_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/intro_card_background">
                    <LinearLayout android:id="@+id/action_backup_calls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Backup call logs" android:textSize="16sp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Create a new backup of all call logs on this device" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#332F292B"/>
                    <LinearLayout android:id="@+id/action_restore_calls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restore call logs" android:textSize="16sp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Restore call logs from the most recent backup" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                            <TextView android:id="@+id/action_calls_from_device" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="12dp" android:background="@drawable/intro_card_background" android:text="@string/home_from_device" android:clickable="true" android:focusable="true"/>
                            <TextView android:id="@+id/action_calls_from_cloud" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:padding="12dp" android:background="@drawable/intro_card_background" android:text="@string/home_from_cloud" android:clickable="true" android:focusable="true"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"
                    android:text="FOLDERS QUICK ACTIONS" android:textSize="12sp" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary"/>
                <LinearLayout android:id="@+id/folders_quick_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/intro_card_background">
                    <LinearLayout android:id="@+id/action_backup_folders" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Backup folders" android:textSize="16sp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Create backups for folder setups on this device" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#332F292B"/>
                    <LinearLayout android:id="@+id/action_restore_folders" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restore folders" android:textSize="16sp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Restore folders from the most recent backups" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                            <TextView android:id="@+id/action_folders_from_device" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="12dp" android:background="@drawable/intro_card_background" android:text="@string/home_from_device" android:clickable="true" android:focusable="true"/>
                            <TextView android:id="@+id/action_folders_from_cloud" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:padding="12dp" android:background="@drawable/intro_card_background" android:text="@string/home_from_cloud" android:clickable="true" android:focusable="true"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"
                    android:text="WALLPAPERS QUICK ACTIONS" android:textSize="12sp" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary"/>
                <LinearLayout android:id="@+id/wallpapers_quick_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/intro_card_background">
                    <LinearLayout android:id="@+id/action_backup_wallpapers" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Backup wallpapers" android:textSize="16sp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Save wallpaper files and setup for this device" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#332F292B"/>
                    <LinearLayout android:id="@+id/action_restore_wallpapers" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restore wallpapers" android:textSize="16sp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Restore wallpaper files from a backup" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                            <TextView android:id="@+id/action_wallpapers_from_device" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="12dp" android:background="@drawable/intro_card_background" android:text="@string/home_from_device" android:clickable="true" android:focusable="true"/>
                            <TextView android:id="@+id/action_wallpapers_from_cloud" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:padding="12dp" android:background="@drawable/intro_card_background" android:text="@string/home_from_cloud" android:clickable="true" android:focusable="true"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"
                    android:text="WIFI QUICK ACTIONS" android:textSize="12sp" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary"/>
                <LinearLayout android:id="@+id/wifi_quick_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/intro_card_background">
                    <LinearLayout android:id="@+id/action_backup_wifi" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Backup WiFi" android:textSize="16sp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Save available WiFi configuration data where Android permits" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#332F292B"/>
                    <LinearLayout android:id="@+id/action_restore_wifi" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restore WiFi" android:textSize="16sp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Restore WiFi configuration where Android permits" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                            <TextView android:id="@+id/action_wifi_from_device" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="12dp" android:background="@drawable/intro_card_background" android:text="@string/home_from_device" android:clickable="true" android:focusable="true"/>
                            <TextView android:id="@+id/action_wifi_from_cloud" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:padding="12dp" android:background="@drawable/intro_card_background" android:text="@string/home_from_cloud" android:clickable="true" android:focusable="true"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/home_content_placeholder" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" android:padding="20dp" android:background="@drawable/intro_card_background" android:textSize="16sp"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@drawable/intro_card_background">
        <TextView android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
            android:gravity="center" android:text="@string/home_nav_home" android:textStyle="bold"/>
        <TextView android:id="@+id/nav_cloud" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
            android:gravity="center" android:text="@string/home_nav_cloud"/>
        <TextView android:id="@+id/nav_schedule" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
            android:gravity="center" android:text="@string/home_nav_schedules"/>
        <TextView android:id="@+id/nav_account" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
            android:gravity="center" android:text="@string/home_nav_account"/>
    </LinearLayout>
</LinearLayout>