<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/apps_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="36sp"
            android:textColor="?android:attr/textColorPrimary"
            android:contentDescription="Back"
            android:background="@drawable/intro_card_background"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/apps_title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/apps_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCAL APPS"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="▾"
                    android:textSize="18sp"
                    android:textColor="?android:attr/colorAccent" />
            </LinearLayout>

            <TextView
                android:id="@+id/apps_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading apps…"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/apps_search_toggle"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⌕"
            android:textSize="30sp"
            android:textColor="?android:attr/textColorPrimary"
            android:contentDescription="Search apps"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/apps_filter_toggle"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="☰"
            android:textSize="23sp"
            android:textColor="?android:attr/textColorPrimary"
            android:contentDescription="Filter apps"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/apps_menu_toggle"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="☷"
            android:textSize="24sp"
            android:textColor="?android:attr/textColorPrimary"
            android:contentDescription="Open apps menu"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/apps_search_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/apps_search"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:hint="Search app or package"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/intro_card_background" />

        <TextView
            android:id="@+id/apps_search_clear"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="×"
            android:textSize="24sp"
            android:textColor="?android:attr/textColorSecondary"
            android:contentDescription="Clear search"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <Spinner
        android:id="@+id/apps_filter"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:contentDescription="App category filter" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/apps_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="100dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/apps_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="No apps match this search."
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/apps_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Loading installed apps…"
            android:background="?android:attr/colorBackground" />
    </FrameLayout>

    <TextView
        android:id="@+id/apps_batch_actions"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_margin="16dp"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="☷  Batch actions"
        android:textStyle="bold"
        android:background="@drawable/intro_card_background"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
