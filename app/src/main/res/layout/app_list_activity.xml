<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/apps_drawer" android:layout_width="match_parent" android:layout_height="match_parent">
<androidx.coordinatorlayout.widget.CoordinatorLayout android:layout_width="match_parent" android:layout_height="match_parent">
<com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content">
<com.google.android.material.appbar.MaterialToolbar android:id="@+id/apps_toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"/>
<com.google.android.material.tabs.TabLayout android:id="@+id/apps_section_tabs" android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/apps_local"/><com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/apps_cloud"/></com.google.android.material.tabs.TabLayout>
</com.google.android.material.appbar.AppBarLayout>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/apps_swipe_refresh" android:layout_width="match_parent" android:layout_height="match_parent" app:layout_behavior="@string/appbar_scrolling_view_behavior"><androidx.recyclerview.widget.RecyclerView android:id="@+id/apps_recycler" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="@dimen/spacing_normal" android:clipToPadding="false"/></androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
<com.bare.apps.ui.AppFastScrollerView android:id="@+id/apps_fast_scroller" android:layout_width="8dp" android:layout_height="match_parent" android:layout_gravity="end" android:background="@drawable/apps_fast_scroller_track"/>
<View android:id="@+id/apps_filter_anchor" android:layout_width="1dp" android:layout_height="1dp" android:layout_gravity="top|end"/>
<com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/apps_batch_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/apps_batch_action" android:layout_gravity="bottom|end" android:layout_margin="@dimen/spacing_medium"/>
<LinearLayout android:id="@+id/apps_empty" android:orientation="vertical" android:gravity="center" android:padding="@dimen/spacing_xlarge" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent"><TextView android:id="@+id/apps_empty_title" style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/apps_empty_message" style="@style/Subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:id="@+id/apps_error" android:orientation="vertical" android:gravity="center" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent"><TextView android:text="@string/apps_error_title" style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:text="@string/apps_error_message" style="@style/Subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
<com.google.android.material.navigation.NavigationView android:layout_width="320dp" android:layout_height="match_parent" android:layout_gravity="start"><LinearLayout android:orientation="vertical" android:padding="@dimen/spacing_medium" android:layout_width="match_parent" android:layout_height="match_parent"><TextView android:text="@string/apps_drawer_title" style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/apps_drawer_quick_actions" android:text="@string/apps_drawer_quick_actions" style="@style/Title" android:paddingVertical="@dimen/spacing_normal" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/apps_drawer_labels" android:text="@string/apps_drawer_labels" style="@style/Title" android:paddingVertical="@dimen/spacing_normal" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/apps_drawer_custom_config" android:text="@string/apps_drawer_custom_config" style="@style/Title" android:paddingVertical="@dimen/spacing_normal" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/apps_drawer_blacklist" android:text="@string/apps_drawer_blacklist" style="@style/Title" android:paddingVertical="@dimen/spacing_normal" android:layout_width="match_parent" android:layout_height="wrap_content"/><Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/><TextView android:id="@+id/apps_drawer_backup_settings" android:text="@string/apps_drawer_backup_settings" style="@style/Title" android:paddingVertical="@dimen/spacing_normal" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/apps_drawer_settings" android:text="@string/apps_drawer_settings" style="@style/Title" android:paddingVertical="@dimen/spacing_normal" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout></com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>