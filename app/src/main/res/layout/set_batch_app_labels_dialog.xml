    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/bottom_dialog_drag_indicator"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_medium"/>
    <include
