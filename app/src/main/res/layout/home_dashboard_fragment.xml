<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dash_fragment_scrollview" android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToPadding="false" android:overScrollMode="never">
    <LinearLayout android:orientation="vertical" android:paddingBottom="24dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="@string/overview" style="@style/SegmentCategoryCaption"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/storage_summary_card" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout android:orientation="vertical" android:padding="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="@string/storage_summary" android:textStyle="bold"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/storage_summary_value" android:text="@string/storage_summary_pending" android:layout_marginTop="8dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:text="@string/quick_actions" style="@style/SegmentCategoryCaption"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:id="@+id/dashboard_actions" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>