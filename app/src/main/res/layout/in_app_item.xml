<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_medium_more"
    app:cardBackgroundColor="?attr/colorSurfaceBright"
    app:cardCornerRadius="@dimen/selectable_card_corner_radius"
    app:cardUseCompatPadding="false"
    app:strokeWidth="@dimen/card_stroke_width"
    style="@style/CardStyleStroked">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_inner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="84dp">
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            android:layout_marginStart="@dimen/spacing_normal"
            android:layout_marginEnd="@dimen/spacing_medium"
            app:layout_constraintBottom_toTopOf="@+id/tv_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/price_column"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Title"/>
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_low"
            android:layout_marginBottom="@dimen/spacing_normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tv_title"
            app:layout_constraintStart_toStartOf="@+id/tv_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/Subtitle"/>
        <LinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:id="@+id/price_column"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/title_larger"
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/tv_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mono_bold"/>
            <TextView
                android:textSize="@dimen/subtitle_small"
                android:gravity="end"
                android:id="@+id/tv_monthly_equivalent"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_low"
                style="@style/Subtitle"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/subtitle_smallest"
        android:textColor="?attr/colorOnPrimary"
        android:layout_gravity="end|top"
        android:id="@+id/tv_badge"
        android:background="@drawable/bg_badge_best_value"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/most_popular"
        android:fontFamily="@font/main_bold"
        android:backgroundTint="?attr/colorPrimary"
        android:paddingHorizontal="@dimen/spacing_medium_more"
        android:paddingVertical="@dimen/spacing_low"/>
</com.google.android.material.card.MaterialCardView>
