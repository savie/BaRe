<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/storage_back"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:gravity="center"
            android:background="@drawable/intro_card_background"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back"
            android:text="‹"
            android:textSize="42sp"
            android:textColor="?android:attr/textColorPrimary" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="@string/storage_for_local_backups"
            android:textSize="20sp"
            android:textStyle="normal"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/storage_detail_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="vertical"
        android:padding="22dp"
        android:background="@drawable/storage_detail_card_background"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:gravity="center"
                android:background="@drawable/intro_card_background"
                android:text="▯"
                android:textSize="28sp"
                android:textColor="#FFAFB9" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="20dp"
                android:text="@string/home_internal_storage"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFAFB9" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/storage_used_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FFAFB9"
            android:progressBackgroundTint="#66565A" />
        <TextView
            android:id="@+id/storage_used_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Reading device storage…"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />
        <TextView
            android:id="@+id/storage_app_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Calculating app usage…"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/backup_folder_location"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />
        <TextView
            android:id="@+id/storage_folder_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Loading account folder…"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textIsSelectable="true" />
    </LinearLayout>
</LinearLayout>
