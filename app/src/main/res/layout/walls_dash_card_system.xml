<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wall_card_system"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:transitionName="wallpaper">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <ImageView
            android:id="@+id/iv_image1"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideline"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/home_screen"
            android:textColor="@color/wht"
            android:background="@color/blk20"
            app:layout_constraintStart_toStartOf="@id/iv_image1"
            app:layout_constraintEnd_toEndOf="@id/iv_image1"
            app:layout_constraintBottom_toBottomOf="@id/iv_image1"
            style="@style/Subtitle"/>
        <ImageView
            android:id="@+id/iv_image2"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            app:layout_constraintStart_toEndOf="@id/guideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/lock_screen"
            android:textColor="@color/wht"
            android:background="@color/blk20"
            app:layout_constraintStart_toStartOf="@id/iv_image2"
            app:layout_constraintEnd_toEndOf="@id/iv_image2"
            app:layout_constraintBottom_toBottomOf="@id/iv_image2"
            style="@style/Subtitle"/>
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/iv_image1"
            style="@style/CardTitle"/>
        <TextView
            android:id="@+id/tv_subtitle2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintStart_toStartOf="@id/tv_title"
            app:layout_constraintEnd_toEndOf="@id/tv_title"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            style="@style/Subtitle"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_shortcut1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/refresh"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintStart_toStartOf="@id/tv_subtitle2"
            app:layout_constraintEnd_toStartOf="@id/btn_shortcut2"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle2"
            style="@style/M3ButtonTonal"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_shortcut2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/backup"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@id/btn_shortcut1"
            app:layout_constraintEnd_toEndOf="@id/tv_subtitle2"
            app:layout_constraintTop_toTopOf="@id/btn_shortcut1"
            style="@style/M3ButtonTonal"/>
        <View
            android:id="@+id/loading_helper"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@id/btn_shortcut1"
            app:layout_constraintEnd_toEndOf="@id/btn_shortcut2"
            app:layout_constraintTop_toTopOf="@id/btn_shortcut1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>