<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:padding="14dp" android:background="@drawable/intro_card_background" android:visibility="gone">
    <TextView android:id="@+id/tv_backend_error_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/firebase_backend_diagnostics_title" android:textStyle="bold" android:textAllCaps="true"/>
    <TextView android:id="@+id/tv_backend_error_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/firebase_backend_diagnostics_message" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>