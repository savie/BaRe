<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@id/tv_sign_in_title" android:textSize="@dimen/title_largest" android:textColor="@color/primary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/signin_title" android:includeFontPadding="false" style="@style/Title"/>
    <TextView android:id="@id/tv_sign_in_subtitle" android:textColor="@color/on_surface_variant" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium" android:text="@string/signin_intro_subtitle" android:lineSpacingExtra="2dp" style="@style/Subtitle.Large"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_large" android:baselineAligned="false">
        <com.bare.intro.IntroBenefitCardView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="@dimen/spacing_medium"
            app:introBenefitIcon="@drawable/ic_cloud_filled" app:introBenefitIconBackgroundTint="@color/blu10" app:introBenefitIconTint="@color/apps"
            app:introBenefitSubtitle="@string/intro_benefit_cloud_subtitle" app:introBenefitTitle="@string/intro_benefit_cloud_title" style="@style/IntroBenefitCard"/>
        <com.bare.intro.IntroBenefitCardView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_medium"
            app:introBenefitIcon="@drawable/ic_verified" app:introBenefitIconBackgroundTint="@color/ambr20" app:introBenefitIconTint="@color/primary"
            app:introBenefitSubtitle="@string/intro_benefit_premium_subtitle" app:introBenefitTitle="@string/intro_benefit_premium_title" style="@style/IntroBenefitCard"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_normal" android:baselineAligned="false">
        <com.bare.intro.IntroBenefitCardView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="@dimen/spacing_medium"
            app:introBenefitIcon="@drawable/ic_key" app:introBenefitIconBackgroundTint="@color/ppl30" app:introBenefitIconTint="@color/ppl"
            app:introBenefitSubtitle="@string/intro_benefit_keys_subtitle" app:introBenefitTitle="@string/intro_benefit_keys_title" style="@style/IntroBenefitCard"/>
        <com.bare.intro.IntroBenefitCardView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_medium"
            app:introBenefitIcon="@drawable/ic_settings" app:introBenefitIconBackgroundTint="@color/grn10" app:introBenefitIconTint="@color/grn"
            app:introBenefitSubtitle="@string/intro_benefit_settings_subtitle" app:introBenefitTitle="@string/intro_benefit_settings_title" style="@style/IntroBenefitCard"/>
    </LinearLayout>
</LinearLayout>