<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:textAppearance="@style/TextAppearance.FilterChip"
    android:textColor="?attr/colorPrimary"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_medium"
    android:layout_marginEnd="@dimen/spacing_medium"
    android:stateListAnimator="@null"
    app:chipBackgroundColor="@color/color_primary_10"
    app:chipCornerRadius="100dp"
    app:chipStrokeColor="?attr/colorPrimary"
    app:chipStrokeWidth="0dp"
    app:chipSurfaceColor="@color/trans"
    app:ensureMinTouchTargetSize="false"
    app:rippleColor="?attr/colorPrimary"/>
