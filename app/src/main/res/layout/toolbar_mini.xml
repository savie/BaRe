<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_mini" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@android:color/transparent" android:elevation="0dp" android:gravity="center_vertical">
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/toolbar_texts"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_medium">
        <CheckedTextView android:id="@+id/tv_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="?android:textColorPrimary" android:textSize="@dimen/title_large" android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/tv_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="?android:textColorSecondary" android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.Toolbar>
