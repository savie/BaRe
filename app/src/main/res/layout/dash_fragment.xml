<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dash_fragment_scrollview" android:scrollbars="none" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="@string/overview" style="@style/SegmentCategoryCaption"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/dash_card_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/activity_vertical_margin" app:cardBackgroundColor="?attr/cardBackgroundColor" app:cardElevation="0dp" app:strokeWidth="0dp">
            <LinearLayout android:orientation="vertical" android:paddingHorizontal="@dimen/spacing_normal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <include android:id="@+id/storage_view" layout="@layout/dash_storage_view"/>
                <View style="@style/DividerThinNoMargins"/>
                <LinearLayout android:orientation="vertical" android:paddingVertical="@dimen/spacing_normal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:text="@string/root_status" style="@style/TextCaption"/>
                    <TextView android:id="@+id/tvRootAccess" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_low" android:text="@string/root_access_not_available" style="@style/Title"/>
                    <TextView android:id="@+id/tvRootProvider" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Subtitle"/>
                </LinearLayout>
                <View style="@style/DividerThinNoMargins"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <include android:id="@+id/dash_card_quick_actions_apps" layout="@layout/quick_action_card"/>
        <include android:id="@+id/dash_card_quick_actions_messages" layout="@layout/quick_action_card"/>
        <include android:id="@+id/dash_card_quick_actions_calls" layout="@layout/quick_action_card"/>
        <include android:id="@+id/dash_card_quick_actions_folders" layout="@layout/quick_action_card"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>