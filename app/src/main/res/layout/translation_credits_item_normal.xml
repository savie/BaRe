<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_medium"
    app:contentPadding="@dimen/spacing_normal">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="center"
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:textAllCaps="true"
            android:fontFamily="@font/main_bold"
            android:letterSpacing="0.08"
            style="@style/TextOverline"/>
        <TextView
            android:textSize="@dimen/title_larger"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/main_medium"
            style="@style/Title.Large"/>
        <View
            android:layout_gravity="center"
            android:layout_width="56dp"
            android:layout_marginTop="@dimen/spacing_medium_more"
            android:layout_marginBottom="@dimen/spacing_medium_more"
            style="@style/DividerThinNoMargins"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_translators"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            style="@style/Subtitle.Large"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
