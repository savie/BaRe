<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/storage_setup_failure_root"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/storage_setup_failure_header"
        android:paddingTop="@dimen/spacing_medium_more"
        android:paddingBottom="@dimen/spacing_medium_more"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:paddingStart="@dimen/spacing_large"
        android:paddingEnd="@dimen/spacing_medium_more"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_storage_setup_failure_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_disk_error"
            android:importantForAccessibility="no"
            app:tint="?attr/colorError2"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tv_storage_setup_failure_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/backup_storage_unavailable"
            android:maxLines="2"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_medium_more"
            style="@style/M3DialogTitle"/>
        <ImageView
            android:id="@+id/iv_storage_setup_failure_menu"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_dots_vertical"
            android:contentDescription="@string/backup_storage_failure_more_options"
            app:tint="?android:attr/textColorSecondary"/>
    </LinearLayout>
    <View
        android:id="@+id/storage_setup_failure_header_divider"
        android:background="?attr/dividerColor"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/storage_setup_failure_header"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/storage_setup_failure_scroll"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/storage_setup_failure_actions_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/storage_setup_failure_header_divider">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_large"
            android:paddingBottom="@dimen/spacing_large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_large"
            android:paddingEnd="@dimen/spacing_large">
            <TextView
                android:textSize="@dimen/title"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/tv_storage_setup_failure_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:fontFamily="@font/main_regular"
                style="@style/M3DialogBody"/>
            <TextView
                android:textSize="@dimen/title"
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/tv_storage_setup_failure_location_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/backup_storage_failure_location_label"
                android:fontFamily="@font/main_medium"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:cardBackgroundColor="?attr/colorBackgroundActivated"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <TextView
                    android:textSize="@dimen/subtitle_large"
                    android:textColor="?android:attr/textColorPrimary"
                    android:id="@+id/tv_storage_setup_failure_location"
                    android:padding="@dimen/spacing_normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    android:fontFamily="monospace"/>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:textSize="@dimen/title_larger"
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/tv_storage_setup_failure_steps_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large_more"
                android:text="@string/backup_storage_what_to_try"
                android:fontFamily="@font/main_medium"/>
            <TextView
                android:textSize="@dimen/title"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/tv_storage_setup_failure_pre_review_step"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal"
                android:lineSpacingExtra="4dp"
                android:fontFamily="@font/main_regular"
                style="@style/M3DialogBody"/>
            <TextView
                android:textSize="@dimen/title"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/tv_storage_setup_failure_review_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal"
                android:lineSpacingExtra="4dp"
                android:fontFamily="@font/main_regular"
                style="@style/M3DialogBody"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_review_storage_access"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium_more"
                android:minHeight="56dp"
                android:text="@string/review_storage_access"
                app:icon="@drawable/ic_settings_storage_filled"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_medium"
                style="@style/M3ButtonTonal"/>
            <TextView
                android:textSize="@dimen/title"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/tv_storage_setup_failure_remaining_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:lineSpacingExtra="4dp"
                android:fontFamily="@font/main_regular"
                style="@style/M3DialogBody"/>
            <TextView
                android:textSize="@dimen/subtitle_large"
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/tv_storage_setup_failure_fallback_note"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/backup_storage_internal_fallback_note"
                android:fontFamily="@font/main_medium"
                style="@style/M3DialogBody"/>
            <TextView
                android:textSize="@dimen/subtitle_large"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/tv_storage_setup_failure_diagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/backup_storage_unavailable_diagnostics"
                android:lineSpacingExtra="3dp"
                android:fontFamily="@font/main_regular"
                style="@style/M3DialogBody"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:id="@+id/storage_setup_failure_actions_divider"
        android:background="?attr/dividerColor"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/storage_setup_failure_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/storage_setup_failure_actions"
        android:paddingTop="@dimen/spacing_medium_more"
        android:paddingBottom="@dimen/spacing_normal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_normal"
        android:paddingEnd="@dimen/spacing_normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_use_internal_storage"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/use_internal_storage"
            style="@style/M3ButtonOutlined"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_low">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_exit_storage_setup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exit"
                style="@style/Widget.Material3.Button.TextButton"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry_storage_setup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/retry"
                app:icon="@drawable/ic_refresh"
                style="@style/M3ButtonTonal"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
