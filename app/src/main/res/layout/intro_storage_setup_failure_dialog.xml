<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/storage_setup_failure_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/tv_storage_setup_failure_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/backup_storage_setup_failure_title" android:textSize="24sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_storage_setup_failure_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/backup_storage_setup_failure_message"/>
        <TextView android:id="@+id/tv_storage_setup_failure_location_label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/backup_storage_failure_location_label" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_storage_setup_failure_location" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="12dp" android:textIsSelectable="true" android:fontFamily="monospace"/>
        <TextView android:id="@+id/tv_storage_setup_failure_steps_label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/backup_storage_what_to_try" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_storage_setup_failure_review_step" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/backup_storage_review_step"/>
        <Button android:id="@+id/btn_review_storage_access" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/review_storage_access" android:enabled="false"/>
        <TextView android:id="@+id/tv_storage_setup_failure_diagnostics" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/backup_storage_diagnostics"/>
    </LinearLayout>
</ScrollView>