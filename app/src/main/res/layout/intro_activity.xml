<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/intro_surface"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:paddingTop="@dimen/spacing_normal"
        android:paddingHorizontal="@dimen/spacing_normal_more"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_normal_more"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/intro_header"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="@dimen/spacing_normal">

                <TextView
                    android:id="@+id/intro_logo"
                    android:text="BΛR☰"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/iv_menu"
                    android:text="⋮"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:background="?selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_sign_in"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_sign_in_title"
                    android:text="@string/signin_title"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginTop="@dimen/spacing_normal_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tv_sign_in_subtitle"
                    android:text="@string/signin_intro_subtitle"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.bare.intro.IntroBenefitCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_medium"
                        app:introBenefitTitle="@string/intro_benefit_cloud_title"
                        app:introBenefitSubtitle="@string/intro_benefit_cloud_subtitle" />

                    <com.bare.intro.IntroBenefitCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_medium"
                        app:introBenefitTitle="@string/intro_benefit_premium_title"
                        app:introBenefitSubtitle="@string/intro_benefit_premium_subtitle" />
                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginTop="@dimen/spacing_normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.bare.intro.IntroBenefitCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_medium"
                        app:introBenefitTitle="@string/intro_benefit_keys_title"
                        app:introBenefitSubtitle="@string/intro_benefit_keys_subtitle" />

                    <com.bare.intro.IntroBenefitCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_medium"
                        app:introBenefitTitle="@string/intro_benefit_settings_title"
                        app:introBenefitSubtitle="@string/intro_benefit_settings_subtitle" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_permissions"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="@dimen/spacing_normal_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_permissions_header"
                    android:text="@string/required_permissions"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.bare.intro.IntroPermissionCardView
                    android:id="@+id/container_storage_perm"
                    android:layout_marginTop="@dimen/spacing_large"
                    app:introPermissionActionText="@string/grant_storage_permission"
                    app:introPermissionSubtitle="@string/storage_perm_subtitle"
                    app:introPermissionTitle="@string/storage_perm_title" />

                <com.bare.intro.IntroPermissionCardView
                    android:id="@+id/container_notifications_perm"
                    android:layout_marginTop="@dimen/spacing_normal"
                    app:introPermissionActionText="@string/grant_notifications_permission"
                    app:introPermissionSubtitle="@string/notifications_perm_subtitle"
                    app:introPermissionTitle="@string/notifications_perm_title" />

                <com.bare.intro.IntroPermissionCardView
                    android:id="@+id/container_installed_apps_perm"
                    android:layout_marginTop="@dimen/spacing_normal"
                    app:introPermissionActionText="@string/grant_installed_apps_permission"
                    app:introPermissionSubtitle="@string/installed_apps_perm_subtitle"
                    app:introPermissionTitle="@string/installed_apps_perm_title" />

                <LinearLayout
                    android:id="@+id/container_root_permissions"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_normal_more">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="@dimen/spacing_medium_more"
                        android:background="?android:attr/listDivider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_root_permissions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_normal_more"
                        android:minHeight="56dp"
                        android:text="@string/root_grant_permissions" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_flow_status"
                android:text="@string/intro_flow_status_sign_in"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_normal_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/intro_bottom_actions"
        android:orientation="vertical"
        android:background="?attr/colorSurfaceContainer"
        android:paddingTop="@dimen/spacing_normal_more"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingHorizontal="@dimen/spacing_large"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_sign_in_subtitle2"
            android:text="@string/backups_tied_warning"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_continue"
            android:text="@string/continue_with_google"
            android:minHeight="56dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_anonymous"
            android:text="@string/skip_sign_in"
            android:minHeight="48dp"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Material3.Button.TextButton" />

        <TextView
            android:id="@+id/tv_privacy_policy"
            android:text="@string/tos_privacy_agreement"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>