<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:clickable="true"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="12dp"
    app:cardCornerRadius="12dp"
    app:contentPadding="16dp"
    app:rippleColor="?attr/colorBackgroundActivated"
    app:strokeColor="?attr/colorPrimary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_title"
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_subtitle"
            style="@style/Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="1.5dp"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/container_slider"
            android:visibility="gone"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

            <TextView
                android:id="@+id/tv_slider_title"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/max_number_backups_to_keep" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_num_of_backups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="2"
                android:valueTo="10"
                android:stepSize="1"
                app:labelBehavior="gone" />

            <TextView
                android:id="@+id/tv_num_of_backups"
                style="@style/Title"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end"
                android:gravity="center"
                android:text="2" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <LinearLayout
            android:id="@+id/container_conditions"
            android:visibility="gone"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/container_slider">

            <TextView
                android:id="@+id/tv_conditions_title"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/new_backup_conditions" />

            <RadioGroup
                android:id="@+id/rg_conditions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_apk_changes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/new_backup_conditions_apk_changes_title" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_data_changes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/new_backup_conditions_data_changes_title" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_any_change"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/new_backup_conditions_any_changes_title" />
            </RadioGroup>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
