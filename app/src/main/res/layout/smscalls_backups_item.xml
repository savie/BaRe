<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/spacing_medium"
    android:paddingBottom="@dimen/spacing_medium"
    android:foreground="?selectableItemBackground">

    <ImageView
        android:id="@+id/image_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/spacing_normal_more"
        android:padding="10dp"
        android:background="@drawable/circle"
        android:backgroundTint="?colorBackgroundActivated"
        android:src="@drawable/ic_app"
        android:tint="?colorPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_subtitle1"
        app:layout_constraintBottom_toBottomOf="@id/tv_subtitle2" />

    <TextView
        android:id="@+id/tv_subtitle1"
        style="@style/TextCaption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_normal"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/image_icon"
        app:layout_constraintEnd_toStartOf="@id/iv_menu"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        style="@style/Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="@id/tv_subtitle1"
        app:layout_constraintEnd_toStartOf="@id/iv_menu"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle1" />

    <TextView
        android:id="@+id/tv_subtitle2"
        style="@style/Subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="@id/tv_title"
        app:layout_constraintEnd_toStartOf="@id/iv_menu"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <ImageView
        android:id="@+id/iv_menu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:padding="13dp"
        android:background="?selectableItemBackgroundBorderless"
        android:src="@drawable/ic_dots_vertical"
        android:tint="?android:textColorSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_subtitle1"
        app:layout_constraintBottom_toBottomOf="@id/tv_subtitle2" />

</androidx.constraintlayout.widget.ConstraintLayout>