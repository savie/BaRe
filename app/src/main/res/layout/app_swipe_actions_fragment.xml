<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/swipe_actions_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/swipe_right"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/right_swipe_preview"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?cardBackgroundColor"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_gravity="start"
                    android:orientation="horizontal"
                    android:background="?colorSurfaceVariant"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/right_preview_primary"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:padding="0dp"
                        android:textSize="9sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/right_preview_secondary"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:padding="0dp"
                        android:textSize="9sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/right_preview_content"
                    android:background="?cardBackgroundColor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="64dp">
                    <include layout="@layout/app_swipe_preview_content" />
                </FrameLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content">

                <LinearLayout android:id="@+id/right_primary_action"
                    android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:layout_width="match_parent" android:layout_height="56dp">
                    <TextView android:text="@string/primary_action"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" />
                    <TextView android:id="@+id/right_primary_value"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp" />
                    <TextView android:text="›" android:textSize="28sp"
                        android:layout_width="24dp" android:layout_height="wrap_content"
                        android:gravity="center" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="?colorOutlineVariant" />

                <LinearLayout android:id="@+id/right_secondary_action"
                    android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:layout_width="match_parent" android:layout_height="56dp">
                    <TextView android:text="@string/secondary_action"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" />
                    <TextView android:id="@+id/right_secondary_value"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp" />
                    <TextView android:text="›" android:textSize="28sp"
                        android:layout_width="24dp" android:layout_height="wrap_content"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="?colorOutlineVariant" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/swipe_left"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/left_swipe_preview"
            android:layout_width="match_parent" android:layout_height="72dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?cardBackgroundColor">

            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:layout_gravity="end"
                    android:orientation="horizontal" android:background="?colorSurfaceVariant"
                    android:layout_width="wrap_content" android:layout_height="match_parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/left_preview_secondary"
                        android:layout_width="64dp" android:layout_height="match_parent"
                        android:padding="0dp" android:textSize="9sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/left_preview_primary"
                        android:layout_width="64dp" android:layout_height="match_parent"
                        android:padding="0dp" android:textSize="9sp" />
                </LinearLayout>

                <FrameLayout android:id="@+id/left_preview_content"
                    android:background="?cardBackgroundColor"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_marginEnd="64dp">
                    <include layout="@layout/app_swipe_preview_content" />
                </FrameLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/left_primary_action"
                    android:gravity="center_vertical" android:clickable="true" android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:layout_width="match_parent" android:layout_height="56dp">
                    <TextView android:text="@string/primary_action"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <TextView android:id="@+id/left_primary_value"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp" />
                    <TextView android:text="›" android:textSize="28sp"
                        android:layout_width="24dp" android:layout_height="wrap_content"
                        android:gravity="center" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="?colorOutlineVariant" />

                <LinearLayout android:id="@+id/left_secondary_action"
                    android:gravity="center_vertical" android:clickable="true" android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:layout_width="match_parent" android:layout_height="56dp">
                    <TextView android:text="@string/secondary_action"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <TextView android:id="@+id/left_secondary_value"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp" />
                    <TextView android:text="›" android:textSize="28sp"
                        android:layout_width="24dp" android:layout_height="wrap_content"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
