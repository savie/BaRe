<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/storage_space_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/spacing_normal">
    <ImageView
        android:id="@+id/iv_switch"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintBottom_toBottomOf="@+id/tvUsage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_storage_type"
        app:tint="?android:attr/textColorSecondary"
        style="@style/CircularActionIcon"/>
    <TextView
        android:id="@+id/tv_storage_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/local_storage"
        android:textAllCaps="true"
        android:layout_marginEnd="@dimen/spacing_medium"
        app:layout_constraintEnd_toStartOf="@+id/iv_switch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextCaption"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvUsage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_low"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="@dimen/spacing_medium"
        app:layout_constraintEnd_toStartOf="@+id/iv_switch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_storage_type"
        style="@style/Subtitle"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBarStorage"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/spacing_low_more"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvUsage"
        style="@style/SwiftLinearProgressIndicator"/>
    <TextView
        android:id="@+id/tvUsedPercent"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_medium"
        app:layout_constraintEnd_toStartOf="@+id/iv_switch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBarStorage"
        style="@style/Subtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
