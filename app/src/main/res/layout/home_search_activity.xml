<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?colorSurfaceContainer" android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/search_toolbar" android:background="@null" android:layout_width="0dp" android:layout_height="56dp"
        android:paddingStart="@dimen/spacing_medium_more" android:paddingEnd="@dimen/spacing_medium_more" android:elevation="0dp"
        app:contentInsetStartWithNavigation="@dimen/spacing_low" app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="?android:textColorPrimary"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <EditText
            android:id="@+id/et_search" android:textSize="@dimen/title" android:textColor="?android:textColorPrimary"
            android:textColorHint="?android:textColorSecondary" android:background="@null" android:layout_width="match_parent"
            android:layout_height="match_parent" android:hint="@string/search_swift_backup" android:maxLines="1"
            android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch"
            android:paddingStart="@dimen/spacing_normal" android:paddingEnd="@dimen/spacing_normal" android:layout_marginEnd="56dp"
            android:importantForAutofill="no" />
        <ImageButton
            android:id="@+id/btn_clear" android:layout_gravity="end|center" android:background="?selectableItemBackgroundBorderless"
            android:padding="@dimen/spacing_medium_more" android:visibility="gone" android:layout_width="56dp" android:layout_height="match_parent"
            android:src="@drawable/ic_menu_close" android:contentDescription="@string/clear_search" app:tint="?android:textColorPrimary" />
    </com.google.android.material.appbar.MaterialToolbar>

    <FrameLayout
        android:id="@+id/search_content_container" android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/search_toolbar">
        <FrameLayout android:id="@+id/search_content" android:layout_width="match_parent" android:layout_height="match_parent">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/search_scroll" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/search_results_container" android:orientation="vertical" android:paddingBottom="@dimen/activity_vertical_margin"
                    android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/activity_horizontal_margin">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/shortcuts_card" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_medium"
                        style="@style/CardStyleNormal">
                        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                            <TextView android:id="@+id/tv_home_search_shortcuts" android:textColor="?android:textColorSecondary"
                                android:paddingTop="@dimen/spacing_medium" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/shortcuts" android:paddingHorizontal="@dimen/spacing_medium" style="@style/SegmentCategoryCaption" />
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_home_search_shortcuts" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:overScrollMode="never" android:nestedScrollingEnabled="false" android:paddingBottom="@dimen/spacing_medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/quick_actions_card" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_medium"
                        style="@style/CardStyleNormal">
                        <LinearLayout android:orientation="vertical" android:paddingBottom="@dimen/spacing_medium"
                            android:layout_width="match_parent" android:layout_height="wrap_content">
                            <TextView android:id="@+id/tv_home_search_quick_actions" android:textColor="?android:textColorSecondary"
                                android:paddingTop="@dimen/spacing_medium" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/quick_actions" android:paddingHorizontal="@dimen/spacing_medium" style="@style/SegmentCategoryCaption" />
                            <com.bare.views.QuickRecyclerView
                                android:id="@+id/rv_home_search_quick_actions" android:layout_width="match_parent" android:layout_height="wrap_content" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_home_search_quick_actions_toggle" android:visibility="gone"
                                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_low"
                                android:layout_marginBottom="@dimen/spacing_medium" android:text="@string/see_all" android:layout_marginHorizontal="@dimen/spacing_normal"
                                style="@style/M3ButtonTonal" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/apps_card" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_medium"
                        style="@style/CardStyleNormal">
                        <LinearLayout android:orientation="vertical" android:paddingBottom="@dimen/spacing_medium"
                            android:layout_width="match_parent" android:layout_height="wrap_content">
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/home_search_apps_header" android:paddingTop="@dimen/spacing_medium"
                                android:layout_width="match_parent" android:layout_height="wrap_content">
                                <TextView android:id="@+id/tv_home_search_apps" android:textColor="?android:textColorSecondary"
                                    android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/apps"
                                    android:paddingHorizontal="@dimen/spacing_medium"
                                    app:layout_constraintEnd_toStartOf="@id/btn_home_search_apps_system_toggle"
                                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                                    style="@style/SegmentCategoryCaption" />
                                <TextView android:id="@+id/btn_home_search_apps_system_toggle" android:textColor="?android:textColorSecondary"
                                    android:gravity="center" android:background="@drawable/bg_home_search_system_apps_toggle_ripple"
                                    android:visibility="gone" android:layout_width="wrap_content" android:layout_height="36dp"
                                    android:text="@string/hide_system_apps" android:drawablePadding="@dimen/spacing_low_more"
                                    android:contentDescription="@string/hide_system_apps" android:textAllCaps="false"
                                    android:drawableStart="@drawable/ic_home_search_system_apps_visibility"
                                    android:paddingStart="@dimen/spacing_medium" android:paddingEnd="@dimen/spacing_medium"
                                    android:layout_marginEnd="@dimen/spacing_medium" android:drawableTint="?android:textColorSecondary"
                                    app:layout_constraintBottom_toBottomOf="@id/tv_home_search_apps"
                                    app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/tv_home_search_apps"
                                    style="@style/SegmentCategoryCaption" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <com.bare.views.QuickRecyclerView
                                android:id="@+id/rv_home_search_apps" android:layout_width="match_parent" android:layout_height="wrap_content" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/folders_card" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_medium"
                        style="@style/CardStyleNormal">
                        <LinearLayout android:orientation="vertical" android:paddingBottom="@dimen/spacing_medium"
                            android:layout_width="match_parent" android:layout_height="wrap_content">
                            <TextView android:id="@+id/tv_home_search_folders" android:textColor="?android:textColorSecondary"
                                android:paddingTop="@dimen/spacing_medium" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/folder_setups" android:paddingHorizontal="@dimen/spacing_medium" style="@style/SegmentCategoryCaption" />
                            <com.bare.views.QuickRecyclerView
                                android:id="@+id/rv_home_search_folders" android:layout_width="match_parent" android:layout_height="wrap_content" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
            <include android:id="@+id/home_search_empty" android:visibility="gone" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center" layout="@layout/error_layout" />
        </FrameLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>